rules_version = '2';

// ===============================================================
// QIP Assist: Firestore security rules (Firebase project rcem-qip-app)
//
// This file is the source of truth for the rules. Publishing is manual:
// Firebase console -> Firestore Database -> Rules -> paste this whole
// file -> Publish. Merging or deploying the site does NOT change them.
// tests/rules checks every rule in the Firestore emulator first.
//
// ===============================================================
// Assumed data model
// ===============================================================
//
// users/{uid}/projects/{projectId}  - one QIP. Written by its owner
//   (the whole document) except the supervisor's sign-off fields inside
//   `assessment`, which only an invited supervisor may change (see
//   supervisorFields / signOffFields below). Email addresses (admin,
//   invites) only count once verified (token email_verified).
//   Fields used here: supervisors: [{email, addedAt}],
//   qipLeads: [{email, addedAt}], visibility.hideFromDeptQIPLead: bool.
//
// qipUsers/{uid}  - profile: email, displayName, lastLogin, createdAt,
//   roles: list of 'trainee' | 'supervisor' | 'qip_lead' | ... .
//   The roles are self-selected and grant NO data access by themselves.
//
// deptQIPLeads/{uid}  - an approved Departmental QIP Lead. Exists =
//   approved. Written only by the master admin (the Approve button in
//   the Admin audit page). Fields: email, displayName, approvedAt.
//
// supervisorInvites/{email}/invites/{ownerUid}_{projectId}
// qipLeadInvites/{email}/invites/{ownerUid}_{projectId}
//   - one invite per project (invites.js). Fields: email, ownerUid,
//   projectId, projectTitle, traineeName, traineeEmail, addedAt.
//   Created and removed only by the project's owner, read by the
//   invited email.
// supervisorInvites/{email}, qipLeadInvites/{email}  - the OLD shared
//   lists ({projects: [...]}). Still read, never written any more.
//
// roleRequests/{uid}_{role}  - someone asking for the 'supervisor' or
//   'qip_lead' role, with their details (role-requests.js). Written by that
//   person, always as status 'pending'; the master admin approves or rejects
//   it (status 'approved' | 'rejected', decidedAtIso, decidedByEmail) and is
//   the only one who can list them.
//
// roleAuditLog/{id}, projectAccessLog/{id}  - append-only audit trail
//   (audit-log.js). Created by the signed-in person the entry is about
//   (or by the master admin, for approvals), read only by the master admin.
//
// Anything not matched below is denied.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----------------------------------------------
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // An email address only counts once it is proved: Google accounts are, and
    // email + password accounts are after clicking the link the app sends.
    // Without this, anyone could register an unclaimed address with a password.
    function emailVerified() {
      return signedIn() && request.auth.token.get('email_verified', false) == true;
    }
    // The master admin accounts (keep in step with ADMIN_EMAILS in app.js).
    function isMasterAdmin() {
      return emailVerified() && request.auth.token.email in ['emevidence999@gmail.com', 'jaketurner2503@gmail.com'];
    }
    function isApprovedQIPLead() {
      return signedIn()
        && exists(/databases/$(database)/documents/deptQIPLeads/$(request.auth.uid));
    }
    // The department an approved QIP Lead covers ('' if none set yet).
    function leadDepartment() {
      return get(/databases/$(database)/documents/deptQIPLeads/$(request.auth.uid)).data.get('department', '');
    }
    function myEmail() {
      return emailVerified() && request.auth.token.email is string
        ? request.auth.token.email.lower() : '';
    }
    function optionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    // ---- QIP projects ------------------------------------------
    // The only fields a supervisor may write, all inside `assessment`.
    function supervisorFields() {
      return ['supervisorComments', 'signedOff', 'signedOffBy', 'signedOffByUid',
              'signedOffByEmail', 'signedOffGmc', 'signedOffDate', 'lastSupervisorActivityAt'];
    }
    function isInvitedSupervisor(uid, projectId) {
      return signedIn() && request.auth.uid != uid && myEmail() != '' && exists(/databases/$(database)/documents/supervisorInvites/$(myEmail())/invites/$(uid + '_' + projectId));
    }
    function onlySupervisorFieldsChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assessment'])
        && request.resource.data.assessment is map
        && request.resource.data.assessment.diff(resource.data.get('assessment', {}))
             .affectedKeys().hasOnly(supervisorFields())
        && optionalString(request.resource.data.assessment, 'supervisorComments', 20000);
    }

    // The sign-off is the supervisor's: the owner can't set or change it.
    function signOffFields() {
      return ['signedOff', 'signedOffBy', 'signedOffByUid', 'signedOffByEmail', 'signedOffGmc', 'signedOffDate', 'supervisorComments'];
    }
    function ownerLeavesSignOffAlone() {
      let before = resource.data.get('assessment', {});
      let after = request.resource.data.get('assessment', {});
      return after is map
        && after.diff(before is map ? before : {}).affectedKeys().hasAny(signOffFields()) == false;
    }
    // Off unless the owner has switched it on: a project with no 'sharing'
    // field (every new project) is not readable by link.
    function shareLinkOn() {
      return resource.data.get('sharing', {}).get('linkOff', true) == false;
    }
    function isInvitedLead(uid, projectId) {
      return signedIn() && myEmail() != '' && exists(/databases/$(database)/documents/qipLeadInvites/$(myEmail())/invites/$(uid + '_' + projectId));
    }
    function leadSeesInDepartment() {
      return isApprovedQIPLead()
        && leadDepartment() != ''
        && resource.data.department == leadDepartment()
        && resource.data.visibility.hideFromDeptQIPLead == false;
    }
    function notSignedOffAtCreation() {
      return request.resource.data.get('assessment', {}).get('signedOff', false) != true;
    }

    match /users/{uid}/projects/{projectId} {
      // The owner keeps full control of their own projects, except the
      // supervisor's sign-off. (No schema check: a project is one large
      // document the whole app edits.)
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && notSignedOffAtCreation();
      allow update: if isOwner(uid) && ownerLeavesSignOffAlone();
      // A share link opens one project by its exact path without signing
      // in, but only once the owner has switched the link on. Invited supervisors
      // and QIP Leads (and the admin / the department's lead) can always
      // open it. Listing someone else's projects is still refused.
      allow get: if shareLinkOn()
        || isInvitedSupervisor(uid, projectId)
        || isInvitedLead(uid, projectId)
        || isMasterAdmin()
        || leadSeesInDepartment();
      // An invited supervisor saves comments and the SLO 11 sign-off.
      allow update: if isInvitedSupervisor(uid, projectId) && onlySupervisorFieldsChange();
    }

    // The master admin sees every project. An approved QIP Lead sees the
    // projects in their own department that the owner has not hidden
    // (collection-group query in the Admin and QIP Lead views; the lead's
    // query must ask for department == theirs and hideFromDeptQIPLead == false).
    match /{path=**}/projects/{projectId} {
      allow read: if isMasterAdmin() || leadSeesInDepartment();
    }

    // ---- Profiles ---------------------------------------------
    function isValidProfile(data) {
      return optionalString(data, 'email', 320)
        && optionalString(data, 'displayName', 200)
        && optionalString(data, 'lastLogin', 40)
        && optionalString(data, 'createdAt', 40)
        && (!('roles' in data) || (data.roles is list && data.roles.size() <= 10));
    }
    match /qipUsers/{uid} {
      allow read: if isOwner(uid) || isMasterAdmin() || isApprovedQIPLead();
      allow create, update: if isOwner(uid) && isValidProfile(request.resource.data);
      allow delete: if isOwner(uid);
    }

    // ---- Approved QIP Leads (the Approve button) -----------------
    match /deptQIPLeads/{uid} {
      allow get: if isOwner(uid) || isMasterAdmin();
      allow list: if isMasterAdmin();
      allow create, update: if isMasterAdmin()
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'approvedAt', 'department', 'departmentName'])
        && optionalString(request.resource.data, 'department', 100)
        && optionalString(request.resource.data, 'departmentName', 200)
        && optionalString(request.resource.data, 'email', 320)
        && optionalString(request.resource.data, 'displayName', 200)
        && optionalString(request.resource.data, 'approvedAt', 40);
      allow delete: if isMasterAdmin();
    }

    // ---- Departments (EDs), kept by the admin --------------------
    // Trainees pick one for each project; each approved QIP Lead covers one.
    match /departments/{deptId} {
      allow read: if signedIn();
      allow create, update: if isMasterAdmin()
        && request.resource.data.keys().hasOnly(['name', 'createdAtIso'])
        && requiredString(request.resource.data, 'name', 200)
        && optionalString(request.resource.data, 'createdAtIso', 40);
      allow delete: if isMasterAdmin();
    }

    // ---- Role requests (Supervisor / QIP Lead details) ------------
    function requestFields() {
      return ['uid', 'email', 'role', 'status', 'fullName', 'jobTitle', 'hospital', 'organisation',
              'department', 'regNumber', 'workEmail', 'phone', 'reason', 'createdAtIso', 'updatedAtIso'];
    }
    function requiredString(data, field, maxLen) {
      return field in data && data[field] is string && data[field].size() > 0 && data[field].size() <= maxLen;
    }
    function requestStringsOk(d) {
      return optionalString(d, 'email', 320)
        && optionalString(d, 'fullName', 200) && optionalString(d, 'jobTitle', 200)
        && optionalString(d, 'hospital', 200) && optionalString(d, 'organisation', 200)
        && optionalString(d, 'department', 200) && optionalString(d, 'regNumber', 40)
        && optionalString(d, 'workEmail', 320) && optionalString(d, 'phone', 40)
        && optionalString(d, 'reason', 1000)
        && optionalString(d, 'createdAtIso', 40) && optionalString(d, 'updatedAtIso', 40);
    }
    function isOwnRequestId(reqId) {
      return signedIn()
        && (reqId == request.auth.uid + '_supervisor' || reqId == request.auth.uid + '_qip_lead');
    }
    match /roleRequests/{reqId} {
      allow get: if isOwnRequestId(reqId) || isMasterAdmin();
      allow list: if isMasterAdmin();
      // The person asking: their own request only, always back to waiting,
      // with the three required details filled in.
      allow create, update: if isOwnRequestId(reqId)
        && request.resource.data.keys().hasOnly(requestFields())
        && request.resource.data.uid == request.auth.uid
        && reqId == request.auth.uid + '_' + request.resource.data.role
        && request.resource.data.status == 'pending'
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email)
        && requiredString(request.resource.data, 'fullName', 200)
        && requiredString(request.resource.data, 'jobTitle', 200)
        && requiredString(request.resource.data, 'hospital', 200)
        && requestStringsOk(request.resource.data);
      // The master admin: approve, reject or undo. Also creates a 'rejected'
      // record for an old QIP Lead claim made before details were collected.
      allow create, update: if isMasterAdmin()
        && request.resource.data.keys().hasOnly(requestFields().concat(['decidedAtIso', 'decidedByEmail']))
        && request.resource.data.role in ['supervisor', 'qip_lead']
        && request.resource.data.uid is string
        && reqId == request.resource.data.uid + '_' + request.resource.data.role
        && request.resource.data.status in ['pending', 'approved', 'rejected']
        && requestStringsOk(request.resource.data)
        && optionalString(request.resource.data, 'decidedAtIso', 40)
        && optionalString(request.resource.data, 'decidedByEmail', 320);
      // Removing the role withdraws the request.
      allow delete: if isOwnRequestId(reqId) || isMasterAdmin();
    }
    // When the admin was last emailed about a request (netlify function
    // role-request-notify writes it with the person's own token, as a server
    // timestamp). At most one email per person per role per hour; it can only
    // move forward, never be cleared.
    match /roleRequestEmails/{reqId} {
      allow get: if isOwnRequestId(reqId);
      allow create: if isOwnRequestId(reqId)
        && request.resource.data.keys().hasOnly(['sentAt'])
        && request.resource.data.sentAt == request.time;
      allow update: if isOwnRequestId(reqId)
        && request.resource.data.keys().hasOnly(['sentAt'])
        && request.resource.data.sentAt == request.time
        && request.time > resource.data.sentAt + duration.value(1, 'h');
    }

    // ---- Invites ------------------------------------------------
    function isValidInvite(email, inviteId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'ownerUid', 'projectId', 'projectTitle', 'traineeName', 'traineeEmail', 'addedAt'])
        && d.ownerUid == request.auth.uid
        && d.email == email
        && d.projectId is string && d.projectId.size() <= 100
        && inviteId == d.ownerUid + '_' + d.projectId
        && optionalString(d, 'projectTitle', 300)
        && optionalString(d, 'traineeName', 200)
        && optionalString(d, 'traineeEmail', 320)
        && optionalString(d, 'addedAt', 40);
    }
    match /{kind}/{email}/invites/{inviteId} {
      allow read: if (kind == 'supervisorInvites' || kind == 'qipLeadInvites')
        && (myEmail() == email || (resource != null && isOwner(resource.data.ownerUid)));
      allow create, update: if (kind == 'supervisorInvites' || kind == 'qipLeadInvites')
        && signedIn() && isValidInvite(email, inviteId);
      // The ID starts with the owner's account ID, so this works even
      // when the invite is already gone.
      allow delete: if (kind == 'supervisorInvites' || kind == 'qipLeadInvites')
        && signedIn() && inviteId.matches('^' + request.auth.uid + '_.+');
    }
    // The old shared lists: still readable by the invited email, but no
    // longer writable (any signed-in account could overwrite them).
    match /supervisorInvites/{email} {
      allow get: if myEmail() == email;
    }
    match /qipLeadInvites/{email} {
      allow get: if myEmail() == email;
    }

    // ---- Audit trail (append-only) --------------------------------
    match /roleAuditLog/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'action', 'source', 'createdAtIso', 'createdAt'])
        // Only the admin logs approvals (against the lead's account ID);
        // anyone else can only log their own role being added or removed.
        && (isMasterAdmin()
            || (request.resource.data.uid == request.auth.uid
                && request.resource.data.action in ['added', 'removed']
                && request.resource.data.get('source', '') != 'admin'))
        && request.resource.data.action in ['added', 'removed', 'approved', 'rejected', 'revoked']
        && optionalString(request.resource.data, 'email', 320)
        && optionalString(request.resource.data, 'displayName', 200)
        && optionalString(request.resource.data, 'role', 40)
        && optionalString(request.resource.data, 'source', 40)
        && optionalString(request.resource.data, 'createdAtIso', 40);
      allow read: if isMasterAdmin();
    }
    function projectSharedByLink(ownerUid, projectId) {
      return ownerUid is string && projectId is string
        && exists(/databases/$(database)/documents/users/$(ownerUid)/projects/$(projectId))
        && get(/databases/$(database)/documents/users/$(ownerUid)/projects/$(projectId)).data.get('sharing', {}).get('linkOff', true) == false;
    }
    match /projectAccessLog/{id} {
      allow create: if request.resource.data.keys().hasOnly(['viewerUid', 'viewerEmail', 'viaRole', 'ownerUid', 'projectId', 'projectTitle', 'action', 'createdAtIso', 'createdAt'])
        // Signed in: logged as themselves. Not signed in: only a share-link
        // view of a project whose link is switched on.
        && ((signedIn() && request.resource.data.viewerUid == request.auth.uid)
            || (!signedIn()
                && request.resource.data.viewerUid == '(unauthenticated)'
                && request.resource.data.viaRole == 'share_link'
                && request.resource.data.action == 'viewed'
                && projectSharedByLink(request.resource.data.ownerUid, request.resource.data.projectId)))
        && optionalString(request.resource.data, 'viewerEmail', 320)
        && optionalString(request.resource.data, 'viaRole', 40)
        && optionalString(request.resource.data, 'ownerUid', 128)
        && optionalString(request.resource.data, 'projectId', 100)
        && optionalString(request.resource.data, 'projectTitle', 300)
        && optionalString(request.resource.data, 'action', 40)
        && optionalString(request.resource.data, 'createdAtIso', 40);
      // The owner sees who opened their projects (query by ownerUid).
      allow read: if isMasterAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }
  }
}
